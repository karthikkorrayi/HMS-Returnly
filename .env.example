# Copy to .env.local for local development. Never commit .env.local.
# (Supabase is no longer used on this branch: the app runs on plain Postgres,
# Better Auth and a private S3-compatible bucket. See db/README.md.)

# Staff sign in with a username; Better Auth also stores a placeholder email
# <username>@STAFF_EMAIL_DOMAIN. No mail is ever sent. Only change this before
# any staff exist.
STAFF_EMAIL_DOMAIN=staff.invalid

# Optional, development only: your computer's LAN IP so a phone on the same
# Wi-Fi can use `npm run dev:lan` (e.g. 192.168.1.20).
DEV_LAN_HOST=

# --- Plain Postgres and Better Auth ---------------------------------------------
# The whole app uses these. Locally,
# `npm run db:local:setup` prints the three database URLs (no passwords: local
# Postgres only). On Railway (Phase 7) the values come from Railway; never commit them.
# The web app logs in as app_user (it refuses to start as anything else):
DATABASE_URL=
# The migration runner (npm run db:migrate) logs in as app_owner:
MIGRATION_DATABASE_URL=
# Sign-in (Better Auth) logs in as auth_service (it refuses to start as anything else):
AUTH_DATABASE_URL=
# The public address of the app, e.g. https://returnly.example (http://localhost:3000 locally):
BETTER_AUTH_URL=
# 32+ random characters, different per environment. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The one header the hosting proxy sets with the visitor IP (verified on staging, Phase 7):
AUTH_IP_HEADER=x-real-ip

# --- Photos (Phase 5): private S3-compatible bucket ------------------------------
# The app is the only way in: it checks the staff member on every upload and
# view. Locally: versitygw (brew install versitygw; npm run storage:local).
# On Railway (Phase 7): the bucket's own values. Never commit them.
S3_ENDPOINT=
S3_BUCKET=item-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# true for versitygw (http://host/bucket/key); some providers need false.
S3_PATH_STYLE=true
# Local only: folder for test photos, outside the repository (default ~/ReturnlyDev/photos).
S3_LOCAL_DIR=
