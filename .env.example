# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server only. Used to create/disable staff logins. Keep it out of the browser,
# chat messages and screenshots.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Staff sign in with a username; Supabase needs an email, so usernames map to
# <username>@STAFF_EMAIL_DOMAIN. No mail is ever sent. Only change this before
# any staff exist — changing it later breaks existing logins.
STAFF_EMAIL_DOMAIN=staff.invalid
